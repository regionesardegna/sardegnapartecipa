# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# --- Bundler, Node & Yarn ---
/.bundle
/node_modules
/yarn-error.log
yarn-debug.log*
.yarn-integrity
/packages

# --- Database & History ---
/db/*.sqlite3
/db/*.sqlite3-journal
.byebug_history

# --- Logs & Temp ---
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep

# --- Storage & Uploads ---
/storage/*
!/storage/.keep
/storage_OLD/*
/public/uploads/*
!/public/uploads/.keep

# --- Assets & Webpack/Vite Packs ---
/public/assets/*
!/public/assets/.keep
/public/packs
/public/packs-test
/public/decidim-packs

# --- Service Worker ---
/public/sw*

# --- Credentials & Config Secrets ---
/config/master.key
/config/credentials.yml.enc
/config/application*.yml
/config/idp_metadata/*
!/config/idp_metadata/.keep
/config/signed_sp_metadata/*
!/config/signed_sp_metadata/.keep

# --- Keys & Certificates ---
/lib/.keys/*
!/lib/.keys/.keep