# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# IDE and editors
.idea/
.vscode/
*.swp
*.swo

# Bundler & packages
/.bundle
/packages

# Database
/db/*.sqlite3
/db/*.sqlite3-journal

# Logs and temp files
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
.byebug_history

# Uploads and storage
/storage/*
/storage_OLD/*
!/storage/.keep
public/uploads
!/public/uploads/.keep

# Master key, credentials and application configs
/config/master.key
/config/credentials.yml.enc
config/application*.yml

# Signed SP, IDP metadata and certificates
config/signed_sp_metadata/*
!/config/signed_sp_metadata/.keep
config/idp_metadata/*
!/config/idp_metadata/.keep
lib/.keys/*
!/lib/.keys/.keep

# Assets, packs and service worker
public/assets/**
!/public/assets/.keep
public/sw.js
public/sw.js.br
public/sw.js.gz
public/sw.js.map
public/sw.js.map.br
public/sw.js.map.gz
/public/packs
/public/decidim-packs
/public/packs-test

# Node & Yarn
/node_modules
/yarn-error.log
yarn-debug.log*
.yarn-integrity

# Testing & Tools
.rspec-failures
/spec/examples.txt
.junie/*
