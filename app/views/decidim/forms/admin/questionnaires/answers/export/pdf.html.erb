<div class="questionnaire-answers">
  <div class="header">
   <th style="background-color: white;">
	<table style="width:100%;">
	  <tr style="width:100%;">
		<th>
			<%= link_to organization.host do %>
				<% if organization.logo.attached? %>
				  <%= image_tag(
						organization.attached_uploader(:logo).variant_url(:medium, host: organization.host),
						style: "max-height: 100px;float:left",
						alt: "#{organization.name}"
					  ) %>
				<% else %>
				  <span><%= organization.name %></span>
				<% end %>
			<% end %>
		</th>
		<th>
		  <% if organization.official_img_header.attached? %>
				<%= link_to organization.official_url do %>
				  <%= image_tag organization.attached_uploader(:official_img_header).url(host: organization.host), alt: "", style: "max-height: 100px;float:right" %>
				<% end %>
		  <% end %>
		</th>
	  </tr>
	</table>
  </th>
  
	<h2><%= translated_attribute(questionnaire.title) %></h2>
    <div class="description">
      <%== translated_attribute(questionnaire.description).html_safe %>
    </div>
    <% if collection.count > 1 %>
      <h3><%= t("title", scope: "decidim.forms.admin.questionnaires.answers.index", total: collection.count) %></h3>
    <% end %>
  </div>

  <%= render partial: "decidim/forms/admin/questionnaires/answers/export/answer", collection: collection, locals: { questionnaire: questionnaire }, as: :participant %>
</div>