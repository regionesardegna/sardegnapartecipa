<% if organization %>
  <%= link_to decidim.root_url(host: organization.host), "aria-label": "home del sito SardegnaParteciPA" do %>
    <% if organization.logo.attached? %>
      <%= image_tag organization.attached_uploader(:logo).variant_path(:medium), alt: "home del sito SardegnaParteciPA", title: "home del sito SardegnaParteciPA"  %>
    <% else %>
      <span><%= organization.name %></span>
    <% end %>
  <% end %>
<% else %>
  <%= Decidim.application_name %>
<% end %>