<%= link_to decidim.root_url, class: "main-bar__links-mobile__item" do %>
  <%= icon "home-2-line" %><span><%= t("decidim.menu.home") %></span>
<% end %>

<button id="dropdown-trigger-links-mobile-search" class="main-bar__links-mobile__item" data-component="dropdown" data-target="dropdown-menu-search-mobile" data-autofocus="input-search-mobile">
  <%= icon "search-line" %><span><%= t("decidim.search.term_input_placeholder") %></span>
</button>

<% if Gem.loaded_specs.has_key?("decidim-participatory_processes") %>
  <%= link_to decidim_participatory_processes.participatory_processes_path, class: "main-bar__links-mobile__item" do %>
    <%= icon "chat-1-line" %><span><%= t("decidim.menu.processes") %></span>
  <% end %>
<% end %>

<% if mobile_assemblies_active? %>
  <%= link_to decidim_assemblies.assemblies_path, class: "main-bar__links-mobile__item" do %>
    <%= icon "bank-line" %><span><%= t("decidim.menu.assemblies") %></span>
  <% end %>
<% end %>

<%= link_to decidim.page_path("help"), class: "main-bar__links-mobile__item" do %>
  <%= icon "question-line" %><span><%= t("decidim.menu.help") %></span>
<% end %>