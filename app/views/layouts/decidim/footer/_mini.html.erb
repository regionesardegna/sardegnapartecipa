# 
# Modificato per gestire in tre colonne uguali il mini-footer e per comprendere il logo Partecipa e il copyright
%>

<div class="mini-footer">
   <div class="mini-footer__content">

      <!-- COLONNA 1 (SINISTRA): Licenza CC -->
      <div class="footer-column-left">	
         <a class="flex gap-1 hover:opacity-50" rel="license noopener noreferrer" href="http://creativecommons.org" target="_blank" data-external-link="text-only">
            <span class="sr-only"><%= t("layouts.decidim.footer.cc_by_license") %></span>
            <%= icon "creative-commons-line", class: "w-6 h-6 fill-current" %>
            <%= icon "creative-commons-by-line", class: "w-6 h-6 fill-current" %>
            <%= icon "creative-commons-sa-line", class: "w-6 h-6 fill-current" %>
         </a>
      </div>

      <!-- COLONNA 2 (CENTRO): Testo Software Libero -->
      <div class="footer-column-center text-xs mt-2 [&_a]:underline">
         <%= t("layouts.decidim.footer.made_with_open_source").html_safe %>
      </div>
    
      <!-- COLONNA 3 (DESTRA): Copyright + Logo perfettamente incolonnati -->
      <div class="footer-column-right">  
         <!-- Il copyright ora vive qui, sopra il logo -->
         <div class="copyright">
            <span class="copyright-text">© 2026 Regione Autonoma della Sardegna</span>
         </div>

         <!-- Il logo SardegnaParteciPA subito sotto -->
		 <%= link_to t("layouts.decidim.footer.mini.logo_link") do %>
			<%= image_tag current_organization.attached_uploader(:official_img_footer).url, 
			title: t("layouts.decidim.footer.mini.logo_title"), 
			alt: t("layouts.decidim.footer.mini.logo_alt"), 
			aria: { label: t("layouts.decidim.footer.mini.logo_aria_label") }, 
			class: "footer_logo logo_partecipa",
			role: "img" %>
		 <% end %>
      </div>
	
   </div>
</div>

<a href="#top">
    <div id="back-to-top">		
        <%= external_icon "media/images/back-to-top.svg", class: "back-to-top-img", alt: "Torna su", 'aria-label': "Torna su", role: "img" %>    
	</div>
</a>
