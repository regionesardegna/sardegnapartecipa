# Modificato per integrare la sezione di footer che prevede i loghi ed eliminare il language chooser
%>

<div class="main-footer">
  <div class="main-footer__top">
	<!-- AGGIUNTO: Contenitore per limitare e centrare il contenuto -->
    <div class="container mx-auto px-4 lg:px-8">
		<div class="w-full">
		  <%= render partial: "layouts/decidim/footer/main_intro" %>
		</div>
		<div class="w-full grid grid-cols-1 gap-x-6 gap-y-10 lg:grid-cols-3 text-md text-white">
		  <%= render partial: "layouts/decidim/footer/main_links" %>
		</div>
		<%= cell("decidim/footer_pages", :topics) %>
	</div>
  </div>
  
  <div class="main-footer__middle">
	<!-- AGGIUNTO: Contenitore anche qui per allineare i loghi -->
    <div class="container mx-auto px-4 lg:px-8">
       <%= render partial: "layouts/decidim/footer/main_logos" %>
	</div>
  </div>
  
  <div class="main-footer__down">
	<!-- AGGIUNTO: Contenitore anche qui per allineare i loghi -->
    <div class="container mx-auto px-4 lg:px-8">
		<nav class="md:w-1/2 lg:w-auto" role="navigation" aria-label="<%= t("layouts.decidim.footer.main.legal_aria_label") %>">
		  <%= render partial: "layouts/decidim/footer/main_legal" %>
		</nav>
		<nav class="max-w-fit w-full md:w-auto md:ml-auto" role="navigation" aria-label="<%= t("layouts.decidim.footer.main.social_aria_label") %>">
		  <%= render partial: "layouts/decidim/footer/main_social_media_links" %>
		</nav>
    </div>
  </div>
</div>