<div class="mini-footer">
  <div class="row">
   <div class="column main__footer__nav">
    <nav class="main__footer__nav">
      <ul class="footer-nav">
      <% organization_pages = current_organization.static_pages_accessible_for(current_user) %>
      <% if organization_pages.any? %>
        <% current_organization.static_page_topics.where(show_in_footer: true).each do |page_topic| %>
        <% topic_pages = page_topic.accessible_pages_for(current_user) %>
        <% if page_topic.pages.any? %>
          <li><%= link_to translated_attribute(page_topic.title), decidim.page_path(page_topic.pages.first) %></li>
        <% end %>
      <% end %>
      <% current_organization.static_pages.where(show_in_footer: true).each do |page| %>
        <li><%= link_to translated_attribute(page.title), decidim.page_path(page) %></li>
        <% end %>
      <% end %>
      <li class="footer_copyright">
          © 2023 Regione Autonoma della Sardegna
      </li>
      </ul>
    </div>
  </div>
</div>

<a href="#top">
    <div id="back-to-top">        
        <%= external_icon "media/images/back-to-top.svg", class: "back-to-top-img", alt: "Torna su", 'aria-label': "Torna su", role: "img" %>    
    </div>
</a>
<script>
    window.addEventListener("scroll",function(){
        if(window.pageYOffset > 300) {
            if (document.body.clientWidth <= 640){
                document.getElementById("back-to-top").setAttribute("style","bottom: 270px");
            }
            document.getElementById("back-to-top").style.display="block";
        } else {
            document.getElementById("back-to-top").style.display="none";
        }
    });
</script>    
<script>
    
    window.addEventListener("scroll",function(){
        let stickyHeader = document.getElementById("sticky-header");
        let sticky = stickyHeader.offsetTop;
        
        if (document.body.clientWidth >= 640){
            if(window.pageYOffset > sticky){    
                
                stickyHeader.classList.add("sticky-header");
                document.getElementById("menu-bar-logo").style.display="block";
                document.getElementById("title-bar").style.display="none";
                if (document.getElementById("img-user-icon") !== null) document.getElementById("img-user-icon").style.display="none";
                if (document.getElementById("institutional-link") !== null) document.getElementById("institutional-link").style.fontSize = "12px";
                if (document.getElementById("img-gonfalone") !== null) document.getElementById("img-gonfalone").setAttribute("style","height:24px");
                
            } else {
                
                stickyHeader.classList.remove("sticky-header");
                if (document.getElementById("menu-bar-logo") !== null) document.getElementById("menu-bar-logo").style.display="none";
                if (document.getElementById("title-bar") !== null) document.getElementById("title-bar").style.display="block";
                if (document.getElementById("img-user-icon") !== null) document.getElementById("img-user-icon").style.display="inline-block";
                if (document.getElementById("institutional-link") !== null) document.getElementById("institutional-link").style.fontSize = "14px";
                document.getElementById("img-gonfalone").setAttribute("style","height:28px");
            }
        }else{
            if(window.pageYOffset > sticky){
                
                stickyHeader.classList.add("sticky-header");
                if (document.getElementById("top-header") !== null) document.getElementById("top-header").setAttribute("style","height:28px");
                if (document.getElementById("img-user-icon") !== null) document.getElementById("img-user-icon").style.display="none";
                if (document.getElementById("img-gonfalone") !== null) document.getElementById("img-gonfalone").setAttribute("style","height:24px");
            } else {
                
                stickyHeader.classList.remove("sticky-header");
                if (document.getElementById("top-header") !== null) document.getElementById("top-header").setAttribute("style","height:40px");
                if (document.getElementById("img-user-icon") !== null) document.getElementById("img-user-icon").style.display="inline-block";
                if (document.getElementById("img-user-icon") !== null) document.getElementById("img-gonfalone").setAttribute("style","height:28px");
            }
        }
    });
</script>
