<section class="extended home-section">
  <div class="wrapper-home">
	<div class="row column text-center">
      <h2 class="heading3"><%= t("decidim.pages.home.extended.what_are_participatory_processes") %></h2>
    </div>
	<div class="row column text-center" style="margin-top:3em;margin-bottom:4em">
      <h3 class="heading4"><%= t("decidim.pages.home.extended.what_are_participatory_processes_explanation") %></h2>
    </div>
    <div class="row column text-center">
      <h2 class="heading3"><%= t("decidim.pages.home.extended.how_to_participate") %></h2>
    </div>
    <div class="row small-up-1 medium-up-4 home-bullets">
      <div class="column">
        <div class="home-bullet">
          <div class="home-bullet__icon">
            <%= external_icon "media/images/icon-surveys.svg", role: "img", "aria-hidden": true, "aria-label": "Sondaggi" %>
          </div>
          <div class="home-bullet__desc">
            <h3 class="heading4"><%= t("decidim.pages.home.extended.surveys") %></h3>
            <p><%= t("decidim.pages.home.extended.surveys_explanation") %></p>
          </div>
        </div>
      </div>
      <div class="column">
        <div class="home-bullet">
          <div class="home-bullet__icon">
            <%= icon "proposals", role: "img", "aria-hidden": true, "aria-label": "Proposte" %>
          </div>
          <div class="home-bullet__desc">
            <h3 class="heading4"><%= t("decidim.pages.home.extended.proposals") %></h3>
            <p><%= t("decidim.pages.home.extended.proposals_explanation") %></p>
          </div>
        </div>
      </div>
	  <div class="column">
        <div class="home-bullet">
          <div class="home-bullet__icon">
            <%= external_icon "media/images/icon-participatory_processes.svg", role: "img", "aria-hidden": true, "aria-label": "Testi" %>
          </div>
          <div class="home-bullet__desc">
            <h3 class="heading4"><%= t("decidim.pages.home.extended.participatory_text") %></h3>
            <p><%= t("decidim.pages.home.extended.participatory_text_explanation") %></p>
          </div>
        </div>
      </div>
	  <div class="column">
        <div class="home-bullet">
          <div class="home-bullet__icon">
            <%= icon "blog", role: "img", "aria-hidden": true, "aria-label": "Blog" %>
          </div>
          <div class="home-bullet__desc">
            <h3 class="heading4"><%= t("decidim.pages.home.extended.blog") %></h3>
            <p><%= t("decidim.pages.home.extended.blog_explanation") %></p>
          </div>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="columns small-centered small-10
                smallmedium-8 medium-6 large-4">
        <%= link_to t("decidim.pages.home.extended.more_info", resource_name: translated_attribute(current_organization.name, current_organization)), decidim.pages_path, class: "button expanded hollow button--sc" %>
      </div>
    </div>
  </div>
</section>